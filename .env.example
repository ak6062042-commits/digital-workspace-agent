# Secure local server configuration. Generate API_TOKEN with the setup script.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend/db/app.db
API_TOKEN=replace-with-a-long-random-token
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
VITE_API_TOKEN=replace-with-a-long-random-token
REQUEST_MAX_BYTES=262144
RATE_LIMIT_PER_MINUTE=600
SNAPSHOT_RETENTION_DAYS=14
CONTENT_RETENTION_DAYS=30

# State and privacy configuration
AGENT_POLL_INTERVAL=3.0
AGENT_HEARTBEAT_INTERVAL=30.0
BACKEND_API_URL=http://localhost:8000/api/snapshot
DIRECT_DB_FALLBACK=false
CAPTURE_ENABLED=false
AUTO_EXECUTE_LOW_RISK=false
ALLOW_EXTERNAL_LLM=false
LOG_LEVEL=INFO

# Optional integrations. Explicit consent is required before content leaves the machine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=
# `duckduckgo` performs live search (with Bing RSS fallback), reads leading
# result pages, and returns source-attributed briefs. Set `chrome` for manual research.
WEB_SEARCH_PROVIDER=duckduckgo
RESEARCH_MAX_RESULTS=6
RESEARCH_FETCH_RESULTS=4
RESEARCH_MAX_CHARS=6000
SUGGESTION_POLL_SECONDS=5
DOCUMENT_SUGGESTION_SECONDS=20
DOCUMENT_SUGGESTION_COOLDOWN_SECONDS=120
SNAPSHOT_DEDUP_SECONDS=5
OVERVIEW_ITEMS_LIMIT=50
PLANNER_CONTEXT_LIMIT=100
PLANNER_SUGGESTION_LIMIT=50
