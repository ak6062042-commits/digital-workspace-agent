{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResponse",
  "description": "Standard schema for responses returned by the Coordinator to the frontend.",
  "type": "object",
  "properties": {
    "response": {
      "type": "string",
      "description": "Markdown response text generated by the agent"
    },
    "routed_agent": {
      "type": "string",
      "enum": ["task_agent", "state_agent", "web_agent", "coordinator"],
      "description": "The specialized agent that handled or routed this request"
    },
    "tasks_created": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "done": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "due_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["title"]
      },
      "description": "Any tasks created or updated as part of this request"
    },
    "state_snapshot": {
      "type": ["object", "null"],
      "description": "The latest workspace state snapshot referenced during the generation",
      "properties": {
        "id": { "type": ["integer", "null"] },
        "active_app": { "type": ["string", "null"] },
        "active_window_title": { "type": ["string", "null"] },
        "browser_url": { "type": ["string", "null"] },
        "browser_tab_title": { "type": ["string", "null"] },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Response generation timestamp"
    }
  },
  "required": ["response", "routed_agent", "timestamp"],
  "additionalProperties": false
}
