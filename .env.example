# Secure local server configuration. Generate API_TOKEN with the setup script.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./backend/db/app.db
API_TOKEN=replace-with-a-long-random-token
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_TOKEN=replace-with-a-long-random-token
REQUEST_MAX_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
SNAPSHOT_RETENTION_DAYS=14
CONTENT_RETENTION_DAYS=30

# State and privacy configuration
AGENT_POLL_INTERVAL=3.0
AGENT_HEARTBEAT_INTERVAL=30.0
BACKEND_API_URL=http://localhost:8000/api/snapshot
DIRECT_DB_FALLBACK=true
CAPTURE_ENABLED=false
AUTO_EXECUTE_LOW_RISK=true
ALLOW_EXTERNAL_LLM=false
LOG_LEVEL=INFO

# Optional integrations. Explicit consent is required before content leaves the machine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=none
LLM_MODEL=
WEB_SEARCH_PROVIDER=duckduckgo
